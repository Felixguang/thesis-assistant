    {"id": "roman_toc_page", "name": "目录页码", "spec": "大写罗马数字 I, II", "check": "footer"},
    {"id": "no_page_on_abstract", "name": "摘要不标页码", "spec": "摘要及关键词不标页码", "check": "manual"},
    {"id": "binding_order", "name": "装订顺序", "spec": "封面→扉页→承诺书→中文摘要→英文摘要→缩略词→目录→正文→参考文献→附录→致谢→成绩评定表", "check": "static"},
    {"id": "word_count_arts", "name": "字数要求（经管文法类）", "spec": "正文不低于1万字", "check": "count"},
