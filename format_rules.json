    {"id": "reference_format", "name": "参考文献格式", "spec": "GB/T 7714风格，[序号]作者. 题名[J/M/N]. 出版地: 出版者, 年. 页码.", "check": "regex"},
    {"id": "reference_min_count", "name": "参考文献数量", "spec": "不少于15篇", "check": "count"},
